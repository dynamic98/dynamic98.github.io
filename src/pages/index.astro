---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/site';
import { getCollection } from 'astro:content';

const researchThemes = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const publications = (await getCollection('publications')).sort(
  (a, b) => b.data.year - a.data.year || a.data.order - b.data.order
);
---
<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <div>
          <p class="hero-intro"><span class="status-pulse" aria-hidden="true"></span>{profile.role}</p>
          <h1 class="display">Multimodal Interaction &amp; User Modeling</h1>
        </div>
        <p class="lede">I study how behavioral and perceptual signals can be used to understand users and design human-centered intelligent systems, with a particular focus on gaze.</p>
        <div class="hero-meta" aria-label="Research areas">
          <span class="pill">Gaze behavior</span>
          <span class="pill">Multimodal interaction</span>
          <span class="pill">User modeling</span>
          <span class="pill">Human–AI interaction</span>
        </div>
      </div>
      <figure class="hero-portrait">
        <img src="/images/img-profil.jpg" alt="Portrait of Junryeol Jeon" />
      </figure>
    </div>
  </section>

  <section class="vision-section" aria-labelledby="vision-title">
    <div class="shell vision-grid">
      <div>
        <p class="eyebrow">Research Vision</p>
        <h2 class="vision-title" id="vision-title">Modality connects.</h2>
      </div>
      <div>
        <p class="vision-statement">Modality is a relational surface revealing latent states.</p>
        <p class="vision-copy">I view modalities as more than input and output channels. They connect people, systems, and contexts while providing behavioral evidence of states such as attention, intention, affect, understanding, and identity.</p>
        <div class="vision-modalities" aria-label="Modalities">
          <span>Gaze</span>
          <span>Speech</span>
          <span>Music</span>
          <span>Text</span>
          <span>Haptics</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section anchor-section" id="research">
    <div class="shell">
      <div class="section-head-simple section-head-with-copy">
        <div>
          <p class="eyebrow">Research</p>
          <h2 class="section-title">Understanding people through multimodal behavior</h2>
        </div>
        <p class="section-copy">My work connects perception, user modeling, and interaction design. Gaze is a central modality in much of this work, alongside other behavioral, visual, and contextual signals.</p>
      </div>

      <div class="research-arc">
        {researchThemes.map((theme) => (
          <article class="research-arc-card">
            <span class="research-num">{theme.data.number}</span>
            <h3>{theme.data.title}</h3>
            <p class="research-question">{theme.data.question}</p>
            <p class="research-detail">{theme.data.detail}</p>
            <div class="keyword-list compact-keywords">
              {theme.data.keywords.map((keyword) => <span class="pill">{keyword}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section anchor-section" id="projects">
    <div class="shell">
      <div class="section-head-simple section-head-with-copy">
        <div>
          <p class="eyebrow">Projects</p>
          <h2 class="section-title">Selected research lines</h2>
        </div>
        <p class="section-copy">Broader research lines rather than individual papers. Detailed publication records are listed separately below.</p>
      </div>

      <div class="project-grid unified-project-grid">
        {projects.map((project) => (
          <article class="project-card">
            <div class={project.data.image?.startsWith('/images/projects/') ? 'project-visual figure-visual' : 'project-visual'}>
              {project.data.image ? (
                <img src={project.data.image} alt={project.data.imageAlt ?? project.data.title} />
              ) : (
                <div class={`project-art art-${project.data.art ?? 'neutral'}`} aria-hidden="true"></div>
              )}
            </div>
            <div class="project-copy">
              <p class="eyebrow">{project.data.eyebrow}</p>
              <h3>{project.data.title}</h3>
              <p>{project.data.description}</p>
              <div class="keyword-list compact-keywords">
                {project.data.tags.map((tag) => <span class="pill">{tag}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section anchor-section" id="publications">
    <div class="shell">
      <div class="section-head-simple">
        <h2 class="section-title">Publications</h2>
      </div>

      <div class="pub-list">
        {publications.map((pub) => (
          <article class="pub-row">
            <div class="pub-year">{pub.data.year}</div>
            <div>
              <h3 class="pub-title">{pub.data.title}</h3>
              <p class="pub-authors">{pub.data.authors}</p>
              {pub.data.note && <p class="pub-note">{pub.data.note}</p>}
              <p class="pub-venue">{pub.data.venue}</p>
            </div>
            <div class="pub-side">
              <span class="pub-tag">{pub.data.tag}</span>
              {pub.data.href && (
                <a class="external-link" href={pub.data.href} target="_blank" rel="noreferrer">Paper ↗</a>
              )}
            </div>
          </article>
        ))}
      </div>

      <div class="scholar-row">
        <a class="button secondary" href={profile.scholar} target="_blank" rel="noreferrer">Google Scholar ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>
