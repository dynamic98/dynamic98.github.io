---
import BaseLayout from '../layouts/BaseLayout.astro';
import { researchThemes } from '../data/site';
---
<BaseLayout title="Research — Junryeol Jeon" description="Research themes of Junryeol Jeon: conversational coordination, accessible multimodal interaction, and human-centered intelligent systems.">
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">Research</p>
      <h1 class="display">Making intelligent systems easier to read.</h1>
      <p class="lede">My work sits at the intersection of human–computer interaction and AI. I design interactive systems and study the cues people use to understand what those systems are doing, what will happen next, and how to respond.</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="shell theme-stack">
      {researchThemes.map((theme) => (
        <article class="theme-card">
          <span class="research-num">{theme.number}</span>
          <div>
            <h2>{theme.title}</h2>
            <p>{theme.summary}</p>
          </div>
          <div>
            <p>{theme.detail}</p>
            <div class="keyword-list">
              {theme.keywords.map((keyword) => <span class="pill">{keyword}</span>)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="split-head">
        <p class="eyebrow">How I work</p>
        <h2 class="section-title">Build the system. Study the interaction. Trace the experience.</h2>
      </div>
      <div class="method-grid">
        <article class="method-card">
          <h3>Interactive systems</h3>
          <p>Rapid prototyping and implementation of embodied agents, multimodal interfaces, and AI-mediated interaction workflows.</p>
        </article>
        <article class="method-card">
          <h3>Controlled user studies</h3>
          <p>Within-participant experiments, behavioral logging, eye tracking, questionnaires, and interaction-level measures.</p>
        </article>
        <article class="method-card">
          <h3>Mixed-method analysis</h3>
          <p>Combining quantitative comparisons with interviews and open-ended responses to connect measured outcomes with user interpretation.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
